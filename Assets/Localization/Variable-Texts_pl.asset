    m_Metadata:
      m_Items: []
  - m_Id: 1688201011453952
    m_Localized: "Ekwipunek zape\u0142niony"
    m_Metadata:
      m_Items: []
  - m_Id: 1690109042286592
    m_Localized: "Aby podnie\u015B\u0107 pojemnik, musi on by\u0107 pusty."
    m_Metadata:
      m_Items: []
  - m_Id: 1691093596430336
    m_Localized: "Nie mo\u017Cna by\u0107 w trakcie wytwarzania przedmiotu, aby m\xF3c
