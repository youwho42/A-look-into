  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Items-Equipment_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 3ceaecf76a95f6844a2f33f8f87ba0f1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13117218816
    m_Localized: Hache en cuivre
    m_Metadata:
      m_Items: []
  - m_Id: 17269579776
    m_Localized: "Un pain au lait plus assur\xE9 dans sa coupe, toujours techniquement
      douteux, mais avec de meilleures options."
    m_Metadata:
      m_Items: []
  - m_Id: 951139753984
    m_Localized: Hache en fer
    m_Metadata:
      m_Items: []
  - m_Id: 960308502528
    m_Localized: "On atteint le croquant coupant d\u2019une baguette, toujours autant
      impossible, mais \xE7a accompagne tout d\xE9licieusement."
    m_Metadata:
      m_Items: []
  - m_Id: 1327054249984
    m_Localized: Hache en pierre
    m_Metadata:
      m_Items: []
  - m_Id: 1331944808448
    m_Localized: "Coupe comme un biscuit rassis ; techniquement impossible, incroyablement
      d\xE9cevant."
    m_Metadata:
      m_Items: []
  - m_Id: 1578209173504
    m_Localized: Bol en argile
    m_Metadata:
      m_Items: []
  - m_Id: 1580016918528
    m_Localized: "Il ne pourra peut-\xEAtre pas contenir tes espoirs et r\xEAves,
      mais de la soupe ? \xC7a, il sait faire."
    m_Metadata:
      m_Items: []
  - m_Id: 1934066507776
    m_Localized: Pioche en cuivre
    m_Metadata:
      m_Items: []
  - m_Id: 1935551291392
    m_Localized: "Toujours aveugl\xE9ment confiant dans ses coups, celui-ci fr\xE9quente
      aussi les \u201Chautes sph\xE8res\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 2245929787392
    m_Localized: Pioche en fer
    m_Metadata:
      m_Items: []
  - m_Id: 2246529572864
    m_Localized: Une pioche en fer, elle perce la roche vraiment fort, mais vraiment
      vraiment fort, pas comme les deux autres.
    m_Metadata:
      m_Items: []
  - m_Id: 2533814231040
    m_Localized: Pioche en pierre
    m_Metadata:
      m_Items: []
  - m_Id: 2535286431744
    m_Localized: "\xC9tonnamment d\xE9termin\xE9e \xE0 se confronter \xE0 des rochers
      plus gros."
    m_Metadata:
      m_Items: []
  - m_Id: 2803101130752
    m_Localized: Longue-vue I
    m_Metadata:
      m_Items: []
  - m_Id: 2804602691584
    m_Localized: "Parfaitement habile \xE0 fixer maladroitement la faune."
    m_Metadata:
      m_Items: []
  - m_Id: 3147076001792
    m_Localized: Lanterne
    m_Metadata:
      m_Items: []
  - m_Id: 3148502065152
    m_Localized: "D'une mani\xE8re ou d'une autre, cela projette de la lumi\xE8re
      sur toi depuis le haut. Trop bien !"
    m_Metadata:
      m_Items: []
  - m_Id: 14465313694867456
    m_Localized: Boussole I
    m_Metadata:
      m_Items: []
  - m_Id: 14465316446330880
    m_Localized: "Une fois \xE9quip\xE9, tu peux placer un marqueur sur la carte.
      Ca fait appara\xEEtre un <sprite anim=\"0,1,12\"> qui \xE0 examin\xE9 la carte
      une fois et est assez convaincu que votre marqueur se trouve \xAB par l\xE0
      \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14515467328217088
    m_Localized: Boussole II
    m_Metadata:
      m_Items: []
  - m_Id: 14515468460679168
    m_Localized: "Une fois cet objet \xE9quip\xE9, tu peux placer trois marqueurs
      sur la carte. Chaque marqueur pos\xE9 fait appara\xEEtre un <sprite anim=\"0,1,12\">
      qui consulte la carte et affirme, avec une certaine assurance, que ton marqueur
      se trouve \xAB par l\xE0 \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 14516190065516544
    m_Localized: 'Boussole III '
    m_Metadata:
      m_Items: []
  - m_Id: 14516190669496320
    m_Localized: "Une fois cet objet \xE9quip\xE9, tu peux placer cinq marqueurs
      sur la carte. Chaque marqueur pos\xE9 fait appara\xEEtre un <sprite anim=\"0,1,12\">
      qui consulte la carte et affirme, avec une certaine assurance, que ton marqueur
      se trouve \xAB par l\xE0 \xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 81585697497604096
    m_Localized: Phiole
    m_Metadata:
      m_Items: []
  - m_Id: 81585723590369280
    m_Localized: "Elle rec\xE8le des senteurs et des secrets ; bien que cela puisse
      para\xEEtre d\xE9pourvu de sens, il ne laissera rien s\u2019\xE9chapper de
      son contenu."
    m_Metadata:
      m_Items: []
  - m_Id: 89890479312265216
    m_Localized: Longue-vue II
    m_Metadata:
      m_Items: []
  - m_Id: 89890483330408448
    m_Localized: Longue-vue III
    m_Metadata:
      m_Items: []
  - m_Id: 89890481317142528
    m_Localized: "Cette longue-vue permet de suivre des animaux tout \xE0 fait impressionnants."
    m_Metadata:
      m_Items: []
  - m_Id: 89890485268176896
    m_Localized: "Rien ne peut t'\xE9chapper avec \xE7a. N'oublie pas qu'en faisant
      preuve d'une grande capacit\xE9 d'observation, tu pourrais d\xE9couvrir des
      choses que t'aurais jamais voulu savoir."
    m_Metadata:
      m_Items: []
  - m_Id: 100096649893306368
    m_Localized: "B\xE2ton \xE0 piquer I"
    m_Metadata:
      m_Items: []
  - m_Id: 100097158561718272
    m_Localized: "Peut-on vraiment dire qu\u2019on conna\xEEt un objet avant de l\u2019avoir
      piqu\xE9 avec un b\xE2ton ? Eh bien, voici votre outil de base pour \xE7a.\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 103250638734417920
    m_Localized: "B\xE2ton \xE0 piquer II"
    m_Metadata:
      m_Items: []
  - m_Id: 103250759207411712
    m_Localized: "D'accord, t'as bien piqu\xE9, mais as-tu aussi palp\xE9 ? Cette
      fonctionnalit\xE9 offre une capacit\xE9 suppl\xE9mentaire ; alors, lances-toi
      et ajoutes cette action de palpage \xE0 ta pratique d\xE9j\xE0 exceptionnelle
      de piquer."
    m_Metadata:
      m_Items: []
  - m_Id: 103251250695954432
    m_Localized: "B\xE2ton \xE0 piquer III"
    m_Metadata:
      m_Items: []
  - m_Id: 103251361576574976
    m_Localized: "V\xE9ritable expert en mati\xE8re de piquage et de palpage, cette
      am\xE9lioration permet \xE9galement de proc\xE9der \xE0 une bonne vieille sondage.
      Les extraterrestres r\xEAveraient d\u2019avoir un tel instrument dans leur
      arsenal. Piques, palpage et sondages : l\u2019outil ultime."
    m_Metadata:
      m_Items: []
  - m_Id: 113425621485936640
    m_Localized: "Verre \xE0 boire"
    m_Metadata:
      m_Items: []
  - m_Id: 113426094330798080
    m_Localized: "Esp\xE8re \xE9tancher sa soif au prochain point d\u2019eau."
    m_Metadata:
      m_Items: []
  - m_Id: 132969920560947200
    m_Localized: Torche
    m_Metadata:
      m_Items: []
  - m_Id: 132970036936105984
    m_Localized: "L\xE0 pour prendre la noirceur \xE0 la l\xE9g\xE8re. Elle s'en
      moque ouvertement m\xEAme."
    m_Metadata:
      m_Items: []
  - m_Id: 171771272820744192
    m_Localized: Axe IV
    m_Metadata:
      m_Items: []
  - m_Id: 171771300083720192
    m_Localized: Pickaxe IV
    m_Metadata:
      m_Items: []
  - m_Id: 171771376835289088
    m_Localized: "Et voil\xE0, du pain \xE0 l\u2019ail tranchant, tout juste sorti
      du four, clairement le meilleur de tous. C'est aussi possible que j\u2019ai
      simplement faim."
    m_Metadata:
      m_Items: []
  - m_Id: 171771438449614848
    m_Localized: "Bon, fini de plaisanter : \xE7a, \xE7a peut tout d\xE9molir ; une
      relation toxique, une situation inconfortable, voire m\xEAme un rocher."
    m_Metadata:
      m_Items: []
  - m_Id: 174016190196801536
    m_Localized: Pelle en pierre
    m_Metadata:
      m_Items: []
  - m_Id: 174016346082304000
    m_Localized: "Creuse son chemin hors de son c\u0153ur de pierre."
    m_Metadata:
      m_Items: []
  - m_Id: 179381391792332800
    m_Localized: "Sac \xE0 dos (12)"
    m_Metadata:
      m_Items: []
  - m_Id: 179381462487326720
    m_Localized: "Douze emplacements suppl\xE9mentaires pour tenir toutes les choses
      que t'as oubli\xE9 d'avoir plac\xE9 l\xE0.."
    m_Metadata:
      m_Items: []
  - m_Id: 179381506737233920
    m_Localized: "Sac \xE0 dos (24)"
    m_Metadata:
      m_Items: []
  - m_Id: 179381556213243904
    m_Localized: Vingt-quatre emplacements de plus, augmentant le nombre de place
      qu'il faut fouiller pour trouver ce que tu cherche.
    m_Metadata:
      m_Items: []
  - m_Id: 179442305979703296
    m_Localized: Pelle en cuivre
    m_Metadata:
      m_Items: []
  - m_Id: 179442336619094016
    m_Localized: Plus creusante, moins de chocs.
    m_Metadata:
      m_Items: []
  - m_Id: 256628196288028672
    m_Localized: Pelle en fer
    m_Metadata:
      m_Items: []
  - m_Id: 256628210015985664
    m_Localized: Creuse tout, aucune contrainte.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
