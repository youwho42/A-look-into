  m_SharedData: {fileID: 11400000, guid: f472391570da1124a875b2ac5db53485, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 14866243584
    m_Localized: Chauve-souris
    m_Metadata:
      m_Items: []
  - m_Id: 20591468544
    m_Localized: "Cr\xE9ature noctune, unissez-vous !"
    m_Metadata:
      m_Items: []
  - m_Id: 596985307136
    m_Localized: Abeille
    m_Metadata:
      m_Items: []
  - m_Id: 600554659840
    m_Localized: 'Une abeille, bourdonnant et voltigeant. '
    m_Metadata:
      m_Items: []
  - m_Id: 1666511855616
    m_Localized: Ruche
    m_Metadata:
      m_Items: []
  - m_Id: 1670513221632
    m_Localized: "Une maison collante et d\xE9licieuse pour les abeilles !"
    m_Metadata:
      m_Items: []
  - m_Id: 2073611001856
    m_Localized: Papillon bleu
    m_Metadata:
      m_Items: []
  - m_Id: 2080678404096
    m_Localized: Un papillon bleu qui vole !
    m_Metadata:
      m_Items: []
  - m_Id: 2397629374464
    m_Localized: Papillon Campanule Bleue
    m_Metadata:
      m_Items: []
  - m_Id: 2405472722944
    m_Localized: "Un papillon campanule bleu \xE9tincelant !"
    m_Metadata:
      m_Items: []
  - m_Id: 2810139172864
    m_Localized: Papillon vert
    m_Metadata:
      m_Items: []
  - m_Id: 2811569430528
    m_Localized: Un papillon vert, mais pas de rage !
    m_Metadata:
      m_Items: []
  - m_Id: 3130885988352
    m_Localized: Papillon rouge
    m_Metadata:
      m_Items: []
  - m_Id: 3133238992896
    m_Localized: Un papillon rouge qui virevolte !
    m_Metadata:
      m_Items: []
  - m_Id: 3369093095424
    m_Localized: Corbeau
    m_Metadata:
      m_Items: []
  - m_Id: 3374516330496
    m_Localized: Un corbeau dont l'intelligence n'atteint que la cheville d'un vrai
      corbeau.
    m_Metadata:
      m_Items: []
  - m_Id: 5631039299584
    m_Localized: Libellule bleue
    m_Metadata:
      m_Items: []
  - m_Id: 5642208731136
    m_Localized: "Oh, une libellule brillante, mignonne, l\xE9g\xE8re et rapide !
      Un peu bleue celle-l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 5979976032256
    m_Localized: Luciole
    m_Metadata:
      m_Items: []
  - m_Id: 5985395073024
    m_Localized: "Une luciole ! Son p'tit derri\xE8re brille dans l'obscurit\xE9
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 6311481237504
    m_Localized: Sauterelle
    m_Metadata:
      m_Items: []
  - m_Id: 6317709778944
    m_Localized: "Un insecte tr\xE8s sautillant !"
    m_Metadata:
      m_Items: []
  - m_Id: 6605149626368
    m_Localized: Souris
    m_Metadata:
      m_Items: []
  - m_Id: 6606579884032
    m_Localized: Un p'tit bonhomme bien coquin.
    m_Metadata:
      m_Items: []
  - m_Id: 6915100303360
    m_Localized: Chouette
    m_Metadata:
      m_Items: []
  - m_Id: 6917604302848
    m_Localized: "Enclin \xE0 trop refl\xE9chir."
    m_Metadata:
      m_Items: []
  - m_Id: 7186807316480
    m_Localized: Moineau
    m_Metadata:
      m_Items: []
  - m_Id: 7189692997632
    m_Localized: Un tout p'tit oiseau, mignon comme tout et joyeux comme pas deux.
    m_Metadata:
      m_Items: []
  - m_Id: 7458816319488
    m_Localized: "\xC9cureuil"
    m_Metadata:
      m_Items: []
  - m_Id: 7460833779712
    m_Localized: "D'une nature \xE9cureuilesque."
    m_Metadata:
      m_Items: []
  - m_Id: 204766264199536640
    m_Localized: "Un papillon qui \xE9trangement brille un violet fonc\xE9.\n\nOn
      s\u2019attendrait presque \xE0 en trouver un, soit dans une for\xEAt lors d\u2019un
      \xE9v\xE9nement musical, soit sur une autre plan\xE8te. Mais celui-ci est bien
      l\xE0, pr\xE9cis\xE9ment l\xE0 o\xF9 vous avez port\xE9 votre regard et l\u2019avez
      d\xE9couvert ; j\u2019imagine donc qu\u2019il existe simplement l\xE0 o\xF9
      tu l'as vu, ce qui, somme toute, n\u2019a rien de si extraordinaire."
    m_Metadata:
      m_Items: []
  - m_Id: 204766222201970688
    m_Localized: "Un papillon qui \xE9trangement brille un violet fonc\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 204766148105396224
    m_Localized: "Papillon Lumi\xE8re UV"
    m_Metadata:
      m_Items: []
  - m_Id: 204765978378690560
    m_Localized: "Un papillon dont les ailes ont l'extr\xE9mit\xE9 rouge.\n\nOn pourrait
      croire qu\u2019un papillon essentiellement blanc serait qualifi\xE9 <style=\"Italic\">papillon
      blanc</style>, mais il faut croire que l\u2019extr\xE9mit\xE9 de ses ailes
      suffit \xE0 d\xE9finir cet animal. Comme toujours, nous sommes tous d\xE9finis
      par nos traits les moins remarquables, et personne ne vous laissera l\u2019oublier
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 204765927619223552
    m_Localized: "Un papillon dont les ailes ont l'extr\xE9mit\xE9 rouge."
    m_Metadata:
      m_Items: []
  - m_Id: 204765860640382976
    m_Localized: "Papillon \xE0 pointes rouges"
    m_Metadata:
      m_Items: []
  - m_Id: 204765628364021760
    m_Localized: "Un papillon rouge qui virevolte !\n\nCe symbole classique de la
      nature, de la bienveillance et de la libert\xE9 est tout cela, et bien plus
      encore. Cette petite cr\xE9ature vous invite \xE0 r\xEAver de mondes meilleurs
      et de plans d\u2019existence sup\xE9rieurs. Ah, et elle pollinise aussi les
      plantes, entre autres choses."
    m_Metadata:
      m_Items: []
  - m_Id: 204765313304682496
    m_Localized: "Un papillon semi-transparent ! Et ben !\n\nOn peut voir \xE0 travers
      cette petite merveille, il ne cache aucun secret. C\u2019est litt\xE9ralement
      impossible, il est transparent, on voit tout \xE0 travers !"
    m_Metadata:
      m_Items: []
  - m_Id: 204765054197358592
    m_Localized: "Un papillon campanule bleu \xE9tincelant !\n\nCette cr\xE9ature
      lumineuse vous m\xE8nera vers des lieux improbables ! Ne la suit pas, elle
      te guiderais seulement vers une fleur, en pleine nuit. Mais si tu la laisse
      p\xE9n\xE9trer ton esprit, tu d\xE9couvriras des perspectives que seule ta
      m\xE8re avait imagin\xE9es pour toi, des choses grandioses et merveilleuses
      (je sais bien que toutes les m\xE8res ne se valent pas\u2026 d\xE9sol\xE9 pour
      cela)."
    m_Metadata:
      m_Items: []
  - m_Id: 171442508341501952
    m_Localized: "Une b\xEAte bien attrist\xE9 d'une disposition fort ind\xE9sirable.\n\nIl
      se peut qu'il ne sorte que quelques minutes par-ci, par-l\xE0, mais tu pourrais
      trouver sa tra\xEEn\xE9e de larmes utile. Peut-\xEAtre qu'il a besoin d'un
      peu de r\xE9confort?"
    m_Metadata:
      m_Items: []
  - m_Id: 171442461163970560
    m_Localized: "Une b\xEAte bien attrist\xE9 d'une disposition fort ind\xE9sirable."
    m_Metadata:
      m_Items: []
  - m_Id: 171442392368996352
    m_Localized: Le Squonk
    m_Metadata:
      m_Items: []
  - m_Id: 168958231863418880
    m_Localized: "Oh, une libellule \xE9tincelante, mignonne, virevoltante et rapide
      ! D\u2019une teinte plut\xF4t rouge\xE2tre.\n\nCe projectile invers\xE9 n'a
      qu'une seul mission. Y aller. Y arriver. SANS FAUTES ! Et devinez quoi ? Il
      n\u2019\xE9choue jamais."
    m_Metadata:
      m_Items: []
  - m_Id: 168957529552379904
    m_Localized: "Oh, une libellule \xE9tincelante, mignonne, virevoltante et rapide
      ! D\u2019une teinte plut\xF4t rouge\xE2tre."
    m_Metadata:
      m_Items: []
  - m_Id: 168957455854264320
    m_Localized: Libellule rouge
    m_Metadata:
      m_Items: []
  - m_Id: 162445985125556224
    m_Localized: "D'une nature \xE9cureuilesque.\n\nTu pourrais apprendre une chose
      ou deux sur la fa\xE7on de stocker des objets aupr\xE8s de cette petite cr\xE9ature.
      Enfin, si t'es entrain de lire \xE7a, c\u2019est que t'as bel et bien appris
      quelque chose ! Les corbeaux sont intelligents et les hiboux sont sages, mais
      c\u2019est finalement que l\u2019\xE9cureuil qui s\u2019est r\xE9v\xE9l\xE9
      \xEAtre le v\xE9ritable ma\xEEtre."
    m_Metadata:
      m_Items: []
  - m_Id: 162444630323421184
    m_Localized: "Un tout p'tit oiseau, mignon comme tout et joyeux comme pas deux.\n\nImpossible
      de passer \xE0 c\xF4t\xE9 de cette petite chose. Elle est toujours l\xE0, toujours
      pr\xEAte \xE0 bondir ! Bon, d\u2019accord, bondir sur une miette, ce n\u2019est
      peut-\xEAtre pas un exploit, mais quoi, tu ferais mieux? Si tu devais chanter
      comme eux et te nourrir que de restes, tu ne tiendrais pas une semaine, pas
      m\xEAme une semaine, j'te dis ! \r\nEt puis, c\u2019est tellement mignon !
      Comment pourrait-on ne pas craquer ?"
    m_Metadata:
      m_Items: []
  - m_Id: 162441625893134336
    m_Localized: "Enclin \xE0 trop refl\xE9chir.\n\r\nBon, d'accord, certains animaux
      sont intelligents, mais combien en connais-tu qui poss\xE8dent une intelligence
      l\xE9gendaire ? Bon, oui, tous les animaux que nous consid\xE9rons comme intelligents.
      Mais combien sont... sont des oiseaux ? Non ! Combien sont mamif\xE8res...
      Arr\xEAtes de compter ! Tu vas bien finir par comprendre tout, juste pas quand
      tu t'y attends."
    m_Metadata:
      m_Items: []
  - m_Id: 162435225678831616
    m_Localized: "Un insecte tr\xE8s sautillant !\n\nCela produit l\u2019un des sons
      les plus reconnaissables au monde, pourtant, beaucoup ignorent a quel moment
      de la journ\xE9e l'atribuer. Est-ce un son typique de l\u2019\xE9t\xE9 ? Ou
      plut\xF4t du d\xE9but de soir\xE9e ? Quoi qu\u2019il en soit, c\u2019est un
      son tr\xE8s identifiable\u2026 et apaisant\u2026 sauf si t'essaie de dormir.
      Ou bien?"
    m_Metadata:
      m_Items: []
  - m_Id: 162433568421240832
    m_Localized: "Une luciole ! Son p'tit derri\xE8re brille dans l'obscurit\xE9
      !\n\nEt alors, qu\u2019est-ce que \xE7a peut faire ? T'aurais de la chance
      d\u2019avoir des fesses lumineuses ! \r\nCela dit, je parie que \xE7a ne fonctionnerait
      jamais pour une vraie lampe, elles passeraient leur temps \xE0 douter de leur
      propre \xE9clairage."
    m_Metadata:
      m_Items: []
  - m_Id: 162432186876223488
    m_Localized: "Oh, une libellule brillante, mignonne, l\xE9g\xE8re et rapide !
      Un peu bleue celle-l\xE0.\n\nNi livre, ni balance, mais clairement redoutable
      avec ses mandibules. Cette odonate est plus grande que jamais ! Mieux vaut
      respecter cette chasseuse, elle existait avant les dinosaures et sera encore
      l\xE0 bien apr\xE8s toi."
    m_Metadata:
      m_Items: []
  - m_Id: 162428389022031872
    m_Localized: "Le grand ressort du territoire! En plus, rose!\n\nD\u2019une timidit\xE9
      extr\xEAme, et pourtant incroyablement vif ! Ne t'approches pas trop, sinon
      tu risques de l\u2019effrayer ! Par contre, tu l'as vu bondir ! Si tu fais
      un effort, je suis s\xFBr que t'arrives aussi \xE0 faire preuve d\u2019au moins
      autant de gr\xE2ce et de charme irr\xE9sistible... peut-\xEAtre."
    m_Metadata:
      m_Items: []
  - m_Id: 162420616867667968
    m_Localized: "Un corbeau dont l'intelligence n'atteint que la cheville d'un vrai
      corbeau.\n\nEh oui, ce type est si intelligent qu\u2019il sait qu\u2019il existe
      un <style=\"Italic\">quatri\xE8me mur</style> \xE0 briser. Il s\u2019\xE9lance
      dans les airs, observe, apprend, avide de tout d\xE9couvrir. Et il parviendra
      \xE0 ses fins, aussi colossale que puisse para\xEEtre une telle entreprise
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 162419759291883520
    m_Localized: "Entendre le chant de cet oiseau chanteur apporte croissance et
      bonheur. Paix \xE0 toi!\n\nSi t'es un peu triste et les temps sont durs, trouve
      cet oiseau et son chant appaiseras tes maux. Rapide et nerveux, il ne se pose
      jamais au sol, alors regarde en l'air!"
    m_Metadata:
      m_Items: []
  - m_Id: 162415280773455872
    m_Localized: "Une abeille, bourdonnant et voltigeant.\n\nJamais t'aurais cru
      que quelque chose de si petit et discret puisse \xEAtre autant mieleux. Sans
      eux, pas de fleurs, d'odeurs, de beaut\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 162412876661317632
    m_Localized: "Cet ours est bleu, et quoi?\n\nCet ami de taille aime sa tani\xE8re
      comme sa vie paisible. Tellement robuste que seul un arbre peut apaiser ses
      d\xE9mangeaisons. Un \xEAtre plein de conseils bien fond\xE9, mais attention,
      c'est l'une des seuls choses dans ce monde qui peut vraiment te faire mal.
      Ose le taquin\xE9 avec un b\xE2ton, c'est sans doute une bonne id\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 162410698513113088
    m_Localized: "Cr\xE9ature noctune, unissez-vous !\n\nDans la nuit, rapide comme
      une souris, et apparement chauve, elle virvolte dans tout les sens. Elle se
      cache la journ\xE9e et dors, et la nuit elle sort pour manger et voler."
    m_Metadata:
      m_Items: []
  - m_Id: 161295498623901696
    m_Localized: "Un papillon vert, mais pas de rage !\n\nCe papillon tr\xE8s particulier
      n\u2019est ni rouge, ni bleu ! En r\xE9alit\xE9, il est plut\xF4t vert. Enfin,
      vert pour la plupart d\u2019entre vous, j\u2019imagine. Je ne sais pas exactement
      comment fonctionne le daltonisme, mais ce monde doit \xEAtre un v\xE9ritable
      cauchemar pour certains d\u2019entre vous. D\xE9sol\xE9 pour \xE7a\u2026 Peut-\xEAtre
      j'arrive \xE0 trouver une solution un jour ?"
    m_Metadata:
      m_Items: []
  - m_Id: 161285388174417920
    m_Localized: "Un papillon bleu qui vole !\n\nCelui-ci, pr\xE9cis\xE9ment, <style=\"Italic\">voltige</style>,
      il ne <style=\"Italic\">papillonne</style> pas. Ces deux actions sont, de toute
      \xE9vidence, parfaitement distinctes, donc inutile d\u2019essayer de m\u2019en
      convaincre autrement. Si tu cherches quelque chose qui <style=\"Italic\">papillonne</style>,
      va plut\xF4t observer le Papillon rouge. Seulement l\xE0 tu comprendras toute
      la nuance !"
    m_Metadata:
      m_Items: []
  - m_Id: 152665954635538432
    m_Localized: "Entendre le chant de cet oiseau chanteur apporte croissance et
      bonheur. Paix \xE0 toi!"
    m_Metadata:
      m_Items: []
  - m_Id: 152663016605278208
    m_Localized: Merlebleu
    m_Metadata:
      m_Items: []
  - m_Id: 135524365345808384
    m_Localized: Un papillon semi-transparent ! Et ben !
    m_Metadata:
      m_Items: []
  - m_Id: 135524362527236096
    m_Localized: Papillon de Verre
    m_Metadata:
      m_Items: []
  - m_Id: 104807267669958656
    m_Localized: Cet ours est bleu, et quoi?
    m_Metadata:
      m_Items: []
  - m_Id: 104807249105969152
    m_Localized: Ours
    m_Metadata:
      m_Items: []
  - m_Id: 24685122374131712
    m_Localized: Le grand ressort du territoire! En plus, rose!
    m_Metadata:
      m_Items: []
  - m_Id: 24685115461918720
    m_Localized: Cerf
    m_Metadata:
      m_Items: []
  - m_Id: 210918527410429952
    m_Localized: Oiseau rouge
    m_Metadata:
      m_Items: []
  - m_Id: 210918582452281344
    m_Localized: Mais qui c'est qui donne les noms ici? C'est un ouiseau, et il est
      passablement rouge.
    m_Metadata:
      m_Items: []
  - m_Id: 210918636583968768
    m_Localized: "Mais qui c'est qui donne les noms ici? C'est un ouiseau, et il
      est passablement rouge.\n\nOn peut toujours reconna\xEEtre cet oiseau \xE0
      son chant. On dirait presque un enregistrement, et pourtant, \xE0 chaque fois,
      c'est diff\xE9rent. Comment il r\xE9ussi un tel exploit ?"
    m_Metadata:
      m_Items: []
  - m_Id: 239583387685806080
    m_Localized: Mouette
    m_Metadata:
      m_Items: []
  - m_Id: 239583806998765568
    m_Localized: "Tu sais qu\u2019il y a de l'eau en grandes quantit\xE9s \xE0 proximit\xE9
      quand t'entends cet animal."
    m_Metadata:
      m_Items: []
  - m_Id: 239583842969116672
    m_Localized: "Tu sais qu\u2019il y a de l'eau en grandes quantit\xE9s \xE0 proximit\xE9
      quand t'entends cet animal.\n\nAu bord de la mer, le soleil te r\xE9chauffe
      le corps, t'as du sable dans ta culotte et t'es bien trop paresseux pour y
      rem\xE9dier. C\u2019est un choix de vie, on est d'accord, mais si c\u2019est
      le tiens, faut savoir qu\u2019un go\xE9land ne sera jamais bien loin, soit
      pour piquer ton en-cas, soit pour te rappeler o\xF9 tu te trouves, chez lui."
    m_Metadata:
      m_Items: []
  - m_Id: 255867483789516800
    m_Localized: Chenille bleue
    m_Metadata:
      m_Items: []
  - m_Id: 255867543130529792
    m_Localized: "Une petite cr\xE9ature dans une contr\xE9e \xE9trange."
    m_Metadata:
      m_Items: []
  - m_Id: 255867583559426048
    m_Localized: "Une petite cr\xE9ature dans une contr\xE9e \xE9trange.\n\nNe se
      nourrissant que de champignons et de spores, cette1 petite cr\xE9ature est
      devenue pour le moins \xE9trange. En th\xE9orie, elle devrait un jour se m\xE9tamorphoser
      en un \xEAtre ail\xE9 et virevoltant, mais nul ne sait vraiment si ce n'est
      pas l\xE0 le simple fruit des d\xE9lires provoqu\xE9s par les champignons."
    m_Metadata:
      m_Items: []
  - m_Id: 310943624124551168
    m_Localized: x
    m_Metadata:
      m_Items: []
  - m_Id: 310943842480017408
    m_Localized: x
    m_Metadata:
      m_Items: []
  - m_Id: 310943960646144000
    m_Localized: x
    m_Metadata:
      m_Items: []
  - m_Id: 162437287695147008
    m_Localized: "Un p'tit bonhomme bien coquin.\n\nSi certains sont connus pour
      vouloir conqu\xE9rir le monde, d'autres sont des \xEAtres intergalactiques
      qui ont cr\xE9\xE9 ce monde \xE0 l'a base. Quoi qu'il en soit, ils sont clairement
      sup\xE9rieurs \xE0 nous tous. Autant l'accepter tout de suite, c'est plus facile."
    m_Metadata:
      m_Items: []
  - m_Id: 371858902269939712
    m_Localized: Crabe
    m_Metadata:
      m_Items: []
  - m_Id: 371858925145673728
    m_Localized: "Crustac\xE9 joyeux et avide, en mission."
    m_Metadata:
      m_Items: []
  - m_Id: 371859102929637376
    m_Localized: "Crustac\xE9 joyeux et avide, en mission.\n\nConnu pour ses jambes,
      tu ne le trouveras pas vers une plaque de beurre. Les bras en l'air pour un
      rien, on ne sait jamais s\u2019il s\u2019agit d\u2019un avertissement ou d\u2019une
      envie de partager sa joie."
    m_Metadata:
      m_Items: []
  - m_Id: 381630607678885888
    m_Localized: Gerboise
    m_Metadata:
      m_Items: []
  - m_Id: 381630661407920128
    m_Localized: Rien que du rebond !
    m_Metadata:
      m_Items: []
  - m_Id: 381630709780828160
    m_Localized: "Rien que du rebond !\n\nTu pourrais croire que t'ai vu une souris,
      voi un minuscule kangourou, mais non, c\u2019est une gerboise. Mignonne \xE0
      croquer, vive comme l\u2019\xE9clair et plus bondissante qu\u2019un trampoline
      en roue libre."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
