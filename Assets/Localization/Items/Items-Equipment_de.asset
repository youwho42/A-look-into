%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Items-Equipment_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 3ceaecf76a95f6844a2f33f8f87ba0f1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 13117218816
    m_Localized: Kupferaxt
    m_Metadata:
      m_Items: []
  - m_Id: 17269579776
    m_Localized: "Eher ein Schnitt im Stil eines selbstbewussten Br\xF6tchens; technisch
      zwar immer noch fragw\xFCrdig, daf\xFCr aber mit mehr Knusprigkeit."
    m_Metadata:
      m_Items: []
  - m_Id: 951139753984
    m_Localized: Eisenaxt
    m_Metadata:
      m_Items: []
  - m_Id: 960308502528
    m_Localized: Beim Anschneiden ist es so knusprig wie ein Baguette; nach wie vor
      eine Herausforderung, aber es schmeckt einfach zu allem hervorragend.
    m_Metadata:
      m_Items: []
  - m_Id: 1327054249984
    m_Localized: Steinaxt
    m_Metadata:
      m_Items: []
  - m_Id: 1331944808448
    m_Localized: "Schneidet sich wie ein abgestandener Keks; technisch unm\xF6glich,
      auf unm\xF6gliche Weise entt\xE4uschend."
    m_Metadata:
      m_Items: []
  - m_Id: 1578209173504
    m_Localized: Tonnapf
    m_Metadata:
      m_Items: []
  - m_Id: 1580016918528
    m_Localized: "Es kann vielleicht nicht deine Hoffnungen und Tr\xE4ume halten,
      aber Suppe? Das kann es."
    m_Metadata:
      m_Items: []
  - m_Id: 1934066507776
    m_Localized: Kupfer-Spitzhacke
    m_Metadata:
      m_Items: []
  - m_Id: 1935551291392
    m_Localized: "Immer noch blind vor Selbstvertrauen bei seinen Schl\xE4gen, mischt
      sich dieser hier auch unter die \u201EGro\xDFen\u201C."
    m_Metadata:
      m_Items: []
  - m_Id: 2245929787392
    m_Localized: Eisen-Spitzhacke
    m_Metadata:
      m_Items: []
  - m_Id: 2246529572864
    m_Localized: Eine Eisen-Spitzhacke, sie durchdringt den Fels wirklich hart, aber
      wirklich wirklich hart, nicht wie die anderen beiden.
    m_Metadata:
      m_Items: []
  - m_Id: 2533814231040
    m_Localized: Stein-Spitzhacke
    m_Metadata:
      m_Items: []
  - m_Id: 2535286431744
    m_Localized: "\xDCberraschend entschlossen, sich gr\xF6\xDFeren Felsen zu stellen."
    m_Metadata:
      m_Items: []
  - m_Id: 2803101130752
    m_Localized: Fernrohr I
    m_Metadata:
      m_Items: []
  - m_Id: 2804602691584
    m_Localized: Meisterhaft darin, die Tierwelt unbeholfen zu beobachten.
    m_Metadata:
      m_Items: []
  - m_Id: 3147076001792
    m_Localized: Laterne
    m_Metadata:
      m_Items: []
  - m_Id: 3148502065152
    m_Localized: "Auf irgendeine Weise strahlt dies Licht von oben auf dich. Gro\xDFartig!"
    m_Metadata:
      m_Items: []
  - m_Id: 14465313694867456
    m_Localized: Kompass I
    m_Metadata:
      m_Items: []
  - m_Id: 14465316446330880
    m_Localized: "Sobald es ausger\xFCstet ist, kannst du eine Markierung auf der
      Karte platzieren. Daraufhin erscheint ein <sprite anim=\"0,1,12\">, der die
      Karte einmal liest und sich ziemlich sicher ist, dass deine Markierung \u201Ein
      diese Richtung\u201C liegt."
    m_Metadata:
      m_Items: []
  - m_Id: 14515467328217088
    m_Localized: Kompass II
    m_Metadata:
      m_Items: []
  - m_Id: 14515468460679168
    m_Localized: "Sobald der Gegenstand ausger\xFCstet ist, kannst du drei Markierungen
      auf der Karte platzieren. F\xFCr jede platzierte Markierung wird ein <sprite
      anim=\"0,1,12\"> herbeigerufen, der die Karte einmal liest und sich ziemlich
      sicher ist, dass sich dein Ziel in \u201Ediese Richtung\u201C befindet."
    m_Metadata:
      m_Items: []
  - m_Id: 14516190065516544
    m_Localized: Kompass III
    m_Metadata:
      m_Items: []
  - m_Id: 14516190669496320
    m_Localized: "Sobald der Gegenstand ausger\xFCstet ist, kannst du f\xFCnf Markierungen
      auf der Karte platzieren. F\xFCr jede platzierte Markierung wird ein <sprite
      anim=\"0,1,12\"> herbeigerufen, der die Karte einmal liest und sich ziemlich
      sicher ist, dass deine Markierung \u201Ein diese Richtung\u201C liegt."
    m_Metadata:
      m_Items: []
  - m_Id: 81585697497604096
    m_Localized: "Fl\xE4schchen"
    m_Metadata:
      m_Items: []
  - m_Id: 81585723590369280
    m_Localized: "Bewahrt D\xFCfte und Geheimnisse; auch wenn das vielleicht keinen
      Sinn ergibt, so gibt es seinen Inhalt dennoch nicht preis."
    m_Metadata:
      m_Items: []
  - m_Id: 89890479312265216
    m_Localized: Fernrohr II
    m_Metadata:
      m_Items: []
  - m_Id: 89890483330408448
    m_Localized: Fernrohr III
    m_Metadata:
      m_Items: []
  - m_Id: 89890481317142528
    m_Localized: Dieses Fernrohr kann mit einigen ziemlich beeindruckenden Tieren
      mithalten.
    m_Metadata:
      m_Items: []
  - m_Id: 89890485268176896
    m_Localized: "Damit l\xE4sst sich alles erkennen. Vergiss jedoch nicht: Dank
      deiner ausgepr\xE4gten Beobachtungsgabe k\xF6nntest du Dinge enth\xFCllen,
      die du eigentlich gar nicht wissen wolltest."
    m_Metadata:
      m_Items: []
  - m_Id: 100096649893306368
    m_Localized: Stocherstock I
    m_Metadata:
      m_Items: []
  - m_Id: 100097158561718272
    m_Localized: "Kann man wirklich behaupten, einen Gegenstand zu kennen, bevor
      man ihn nicht mal mit einem Stocherstock gepiekt hat? Nun, das hier ist dein
      einfachstes Werkzeug daf\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 103250638734417920
    m_Localized: Stocherstock II
    m_Metadata:
      m_Items: []
  - m_Id: 103250759207411712
    m_Localized: "Okay, du hast also gestupst, aber hast du auch schon kr\xE4ftiger
      nachgebohrt? Das bietet noch zus\xE4tzliche M\xF6glichkeiten; also leg los
      und erg\xE4nze dein exzellentes Stupsen um ein gezieltes Nachbohren."
    m_Metadata:
      m_Items: []
  - m_Id: 103251250695954432
    m_Localized: Stocherstock III
    m_Metadata:
      m_Items: []
  - m_Id: 103251361576574976
    m_Localized: "Ein wahres Meisterwerk, wenn es ums Stupsen, Sto\xDFen und Sondieren
      geht, dieses Upgrade erm\xF6glicht zudem ein gr\xFCndliches Abtasten. Au\xDFerirdische
      w\xFCrden sich w\xFCnschen, sie h\xE4tten ein solches Utensil in ihrem Werkzeugkasten.
      Stupsen, Sto\xDFen, Sondieren, das ultimative Werkzeug."
    m_Metadata:
      m_Items: []
  - m_Id: 113425621485936640
    m_Localized: Trinkglas
    m_Metadata:
      m_Items: []
  - m_Id: 113426094330798080
    m_Localized: "Hofft, seinen Durst an der n\xE4chsten Wasserstelle zu stillen."
    m_Metadata:
      m_Items: []
  - m_Id: 132969920560947200
    m_Localized: Fackel
    m_Metadata:
      m_Items: []
  - m_Id: 132970036936105984
    m_Localized: "Da drau\xDFen, und die Dunkelheit ins L\xE4cherliche ziehen. Ihr
      sozusagen ins Gesicht lachen."
    m_Metadata:
      m_Items: []
  - m_Id: 171771272820744192
    m_Localized: Axe IV
    m_Metadata:
      m_Items: []
  - m_Id: 171771300083720192
    m_Localized: Pickaxe IV
    m_Metadata:
      m_Items: []
  - m_Id: 171771376835289088
    m_Localized: 'Und da haben wir es: gerade frisch aus dem Ofen kommendes Knoblauchbrot;
      eindeutig das Beste von allem. Wobei, vielleicht bin ich auch einfach nur hungrig.'
    m_Metadata:
      m_Items: []
  - m_Id: 171771438449614848
    m_Localized: "Okay, Schluss mit den Sp\xE4\xDFen; das hier kriegt alles klein:
      eine schlechte Beziehung, eine unangenehme Situation oder sogar einen Felsbrocken."
    m_Metadata:
      m_Items: []
  - m_Id: 174016190196801536
    m_Localized: Steinspaten
    m_Metadata:
      m_Items: []
  - m_Id: 174016346082304000
    m_Localized: "Gr\xE4bt sich aus ihrem steinernen Herzen heraus."
    m_Metadata:
      m_Items: []
  - m_Id: 179381391792332800
    m_Localized: Rucksack (12)
    m_Metadata:
      m_Items: []
  - m_Id: 179381462487326720
    m_Localized: "Zw\xF6lf zus\xE4tzliche F\xE4cher f\xFCr all die Dinge, von denen
      du vergessen hast, dass du sie dort hineingelegt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 179381506737233920
    m_Localized: Rucksack (24)
    m_Metadata:
      m_Items: []
  - m_Id: 179381556213243904
    m_Localized: "Vierundzwanzig zus\xE4tzliche Pl\xE4tze, und damit noch mehr Gelegenheiten,
      sich zu fragen, wo dieser eine Gegenstand wohl abgeblieben ist."
    m_Metadata:
      m_Items: []
  - m_Id: 179442305979703296
    m_Localized: Kupferspaten
    m_Metadata:
      m_Items: []
  - m_Id: 179442336619094016
    m_Localized: Mehr buddeln, weniger zucken.
    m_Metadata:
      m_Items: []
  - m_Id: 256628196288028672
    m_Localized: Eisenspaten
    m_Metadata:
      m_Items: []
  - m_Id: 256628210015985664
    m_Localized: "Das ganze Graben, kein \xC4rger."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
