    m_Metadata:
      m_Items: []
  - m_Id: 355719834034176
    m_Localized: "Zostanie utworzony nowy zapis gry z wykorzystaniem nazwy twojej
      postaci, kt\xF3rej nie b\u0119dzie mo\u017Cna zmieni\u0107. B\u0119dziesz jednak
      mie\u0107 mo\u017Cliwo\u015B\u0107 zmiany wygl\u0105du swojej postaci."
    m_Metadata:
      m_Items: []
  - m_Id: 51588595715727360
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 772181937676288
