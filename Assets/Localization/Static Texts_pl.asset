    m_Metadata:
      m_Items: []
  - m_Id: 321843300130476032
    m_Localized: "pad kierunkowy > wybierz : A > ekwipuj / zdejmij / spo\u017Cyj
      : R2 + RS > umie\u015B\u0107 przedmiot w \u015Bwiecie : B > zamknij"
    m_Metadata:
      m_Items: []
  - m_Id: 321843393147555840
    m_Localized: "A/D > wybierz : LMB > ekwipuj / zdejmij / spo\u017Cyj : Przeci\u0105gnij
      i Upu\u015B\u0107 > umie\u015B\u0107 przedmiot w \u015Bwiecie : Tab > zamknij"
    m_Metadata:
      m_Items: []
  - m_Id: 774151670915072
    m_Localized: "Tutaj widoczne s\u0105 przepisy, kt\xF3re otrzymasz po przeprowadzeniu
      bada\u0107 nad danym przedmiotem. Aby przeprowadzi\u0107 badania, musisz posiada\u0107
      w swoim ekwipunku wskazan\u0105 ilo\u015B\u0107 tego przedmiotu."
    m_Metadata:
      m_Items: []
