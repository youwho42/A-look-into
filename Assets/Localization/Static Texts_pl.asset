      m_Items: []
  - m_Id: 6703560581120
    m_Localized: "Wyjd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 204767919284477952
    m_Localized: Czytaj
    m_Metadata:
      m_Items: []
  - m_Id: 1801839751782400
    m_Localized: "Przeczytaj wiadomo\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 774335893135360
    m_Localized: "Oto sk\u0142adniki niezb\u0119dne do przygotowania tego przepisu.
      Je\u015Bli do jego wykonania wymagana jest Agencja, informacja na ten temat
      b\u0119dzie znajdowa\u0142a si\u0119 powy\u017Cej."
    m_Metadata:
      m_Items: []
  - m_Id: 772042779058176
    m_Localized: Przepisy
    m_Metadata:
      m_Items: []
  - m_Id: 1784240049545216
    m_Localized: Wymagane Przedmioty
    m_Metadata:
      m_Items: []
  - m_Id: 1800008690622464
    m_Localized: Zbadaj
    m_Metadata:
      m_Items: []
  - m_Id: 141402458925096960
    m_Localized: "Przepisy poznane dzi\u0119ki badaniu przedmiot\xF3w pojawi\u0105
      si\u0119 tutaj, wraz z informacj\u0105 o tym, jakie przedmioty s\u0105 potrzebne
      do przeprowadzenia badania.\nPrzedmioty te nie zostan\u0105 zu\u017Cyte."
    m_Metadata:
      m_Items: []
  - m_Id: 52292977432256512
    m_Localized: "Automatyczne Resetowanie Przybli\u017Cenia Wy\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 52292548560478208
    m_Localized: "Automatyczne Resetowanie Przybli\u017Cenia W\u0142\u0105czone"
    m_Metadata:
      m_Items: []
  - m_Id: 58335273017729024
    m_Localized: "Za chwil\u0119 powr\xF3cisz do menu g\u0142\xF3wnego. Czy na pewno
      chcesz to zrobi\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 95386918897377280
