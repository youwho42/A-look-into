  m_TableData:
  - m_Id: 19333177344
    m_Localized: PHOOO!
    m_Metadata:
      m_Items: []
  - m_Id: 190599192576
    m_Localized: No, wait. That's not it.
    m_Metadata:
      m_Items: []
  - m_Id: 354604867584
    m_Localized: MOOOO!
    m_Metadata:
      m_Items: []
  - m_Id: 433839464448
    m_Localized: 'Well, whatever, you get the idea, spooky spooky boo''s and bee''s! '
    m_Metadata:
      m_Items: []
  - m_Id: 4836059308032
    m_Localized: BOOOOO! That's it! (I can't believe I can never remember that...)
    m_Metadata:
      m_Items: []
  - m_Id: 227950709350191104
    m_Localized: Fear not my deer!
    m_Metadata:
      m_Items: []
  - m_Id: 227951756944723968
    m_Localized: I might not be of this worldly plane anymore, but I still have feelings.
    m_Metadata:
      m_Items: []
  - m_Id: 227954302694313984
    m_Localized: Have you met my lovely wife, Jocelyn?
    m_Metadata:
      m_Items: []
  - m_Id: 227954432734515200
    m_Localized: You might know her as Grandma.
    m_Metadata:
      m_Items: []
  - m_Id: 227954535385911296
    m_Localized: As much as I hope to see her soon, I also wish her the longest of
      times on this land.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
