  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: NPC-Dialogues-Silas_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: efdc71c9b7b2c5a408ccef2c43d060da, type: 2}
  m_Metadata:
    m_Items:
    - rid: 6674249330832703489
  m_TableData:
  - m_Id: 155648380928
    m_Localized: Whoa there!
    m_Metadata:
      m_Items: []
  - m_Id: 268911366144
    m_Localized: Take a step back stinky.
    m_Metadata:
      m_Items: []
  - m_Id: 390013505536
    m_Localized: You got a name? I'm Silas Hnonk.
    m_Metadata:
      m_Items: []
  - m_Id: 916809699328
    m_Localized: So I bare my soul to you and you just shun me, eh {global.playerName}?
    m_Metadata:
      m_Items:
      - rid: 6674249330832703489
  - m_Id: 1433233379328
    m_Localized: I'm hoping it's nice to meet you {global.playerName}.
    m_Metadata:
      m_Items:
      - rid: 6674249330832703489
  - m_Id: 1653950238720
    m_Localized: 'See ya''round, stinky {global.playerName}... '
    m_Metadata:
      m_Items:
      - rid: 6674249330832703489
  - m_Id: 3566632554496
    m_Localized: I ain't gonna say!
    m_Metadata:
      m_Items: []
  - m_Id: 3609691279360
    m_Localized: I, Silas Hnonk, am {global.playerName}! Lovely to meet you!
    m_Metadata:
      m_Items:
      - rid: 6674249330832703489
  - m_Id: 2908162313015296
    m_Localized: Boyo Boyo! I used to have this shop in the cemetary, but all destroyed
      now.
    m_Metadata:
      m_Items: []
  - m_Id: 2908656473329664
    m_Localized: You seem like a soul that might help.
    m_Metadata:
      m_Items: []
  - m_Id: 2908789231439872
    m_Localized: You Help! I declare it so!
    m_Metadata:
      m_Items: []
  - m_Id: 2908892969160704
    m_Localized: Why Hnonk's not fixed!
    m_Metadata:
      m_Items: []
  - m_Id: 2908992659378176
    m_Localized: I'll sell things of great importance when fixed!
    m_Metadata:
      m_Items: []
  - m_Id: 2909121751666688
    m_Localized: Now fix! I declare it so!
    m_Metadata:
      m_Items: []
  - m_Id: 2909515349348352
    m_Localized: AH! I see it is declared complete!
    m_Metadata:
      m_Items: []
  - m_Id: 2909688217587712
    m_Localized: Tis a grand a glorious day, I declare it so!
    m_Metadata:
      m_Items: []
