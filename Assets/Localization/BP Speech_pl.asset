  m_TableData:
  - m_Id: 26694498443264
    m_Localized: "T\u0119dy {global.playerName}!"
    m_Metadata:
      m_Items:
      - rid: 5413016103378747392
  - m_Id: 12936863744
    m_Localized: "PO\u017BAR!"
    m_Metadata:
      m_Items: []
  - m_Id: 14370656018432
    m_Localized: Moje specjalne miejsce!!
    m_Metadata:
      m_Items: []
  - m_Id: 16306914516992
    m_Localized: Sukces!
    m_Metadata:
      m_Items: []
  - m_Id: 21379367362560
    m_Localized: "Hej! Chcia\u0142em to poliza\u0107!"
    m_Metadata:
      m_Items: []
  - m_Id: 26388427497472
    m_Localized: "Jeste\u015Bmy  na miejscu!"
    m_Metadata:
      m_Items: []
  - m_Id: 56910554087350300
    m_Localized: "Hej! Pos\u0142uchaj!"
    m_Metadata:
      m_Items: []
  - m_Id: 56910666423394300
    m_Localized: Halo?
    m_Metadata:
      m_Items: []
  - m_Id: 56910748044550100
    m_Localized: "Mam co\u015B do powiedzenia!"
    m_Metadata:
      m_Items: []
  - m_Id: 56910882614599700
    m_Localized: "Pogadaj ze mn\u0105!"
    m_Metadata:
      m_Items: []
  - m_Id: 56910929049739300
    m_Localized: Ooo! OOooo!
    m_Metadata:
      m_Items: []
  - m_Id: 56911657583566900
    m_Localized: Przepraszam!
    m_Metadata:
      m_Items: []
  - m_Id: 56911826710487000
    m_Localized: "Mo\u017Cemy porozmawia\u0107?"
    m_Metadata:
      m_Items: []
  - m_Id: 78696241853685800
    m_Localized: "Nie mog\u0142em znale\u017A\u0107 \u015Bcie\u017Cki, jeste\u015B
      zdany na siebie!"
    m_Metadata:
      m_Items: []
  - m_Id: 83443532552527900
    m_Localized: "To nie jest w\u0142a\u015Bciwa droga!"
    m_Metadata:
      m_Items: []
